{
  "info": {
    "name": "Laravel Booking · каталог и свободные окна",
    "description": "Запустите bash scripts/booking-postman.sh, импортируйте созданное окружение и выберите его перед запуском коллекции. Все ID и расписание относятся к демо-базе.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{booking_token}}",
        "type": "string"
      }
    ]
  },
