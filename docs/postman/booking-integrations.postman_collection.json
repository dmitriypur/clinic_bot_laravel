      "name": "Каталог",
      "item": [
        {
          "name": "Видлацкой · два кандидата",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "integrations",
                "v1",
                "catalog",
                "search"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "doctor"
                },
                {
                  "key": "q",
                  "value": "%D0%92%D0%B8%D0%B4%D0%BB%D0%B0%D1%86%D0%BA%D0%BE%D0%B9"
                }
              ],
              "raw": "{{base_url}}/api/integrations/v1/catalog/search?type=doctor&q=%D0%92%D0%B8%D0%B4%D0%BB%D0%B0%D1%86%D0%BA%D0%BE%D0%B9"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Ожидаемый ответ\", () => {",
                  "    const result = pm.response.json();",
                  "    pm.expect(result.data.map(item => item.id)).to.eql([1, 2]);",
                  "    pm.expect(result.meta.ambiguous).to.eql(true);",
                  "    pm.expect(result.data[0].name).to.eql(\"Видлацкая Анна\");",
                  "    pm.expect(result.data[0].branches[0].address).to.eql(\"ул. Ленина, 1\");",
                  "    pm.expect(result.data[1].branches[0].city.name).to.eql(\"Москва\");",
                  "});"
                ]
              }
            }
          ]
        },
