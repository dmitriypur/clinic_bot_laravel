            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
              "pm.test(\"status\", () => pm.expect(pm.response.json().status).to.eql(\"unknown\"));",
              "pm.test(\"operation_id\", () => pm.expect(pm.response.json().operation_id).to.eql(pm.collectionVariables.get(\"unknown_key\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Status · same unresolved operation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/integrations/v1/operations/{{unknown_key}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
              "pm.test(\"status\", () => pm.expect(pm.response.json().status).to.eql(\"unknown\"));",
              "pm.test(\"operation_id\", () => pm.expect(pm.response.json().operation_id).to.eql(pm.collectionVariables.get(\"unknown_key\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Replay · same unresolved operation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{unknown_key}}"
          }
        ],
        "url": "{{base_url}}/api/integrations/v1/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"offer_token\": \"{{unknown_offer}}\",\n  \"full_name\": \"Пациент Тестовый\",\n  \"birth_date\": \"1990-01-01\",\n  \"phone\": \"+70000000000\",\n  \"confirmed\": true,\n  \"privacy_consent\": true\n}",
          "options": {
