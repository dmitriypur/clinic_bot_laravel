            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
              "pm.test(\"status\", () => pm.expect(pm.response.json().status).to.eql(\"unknown\"));",
              "pm.test(\"operation_id\", () => pm.expect(pm.response.json().operation_id).to.eql(pm.collectionVariables.get(\"unknown_key\")));"
            ]
          }
        }
      ]
    }
  ]
}
